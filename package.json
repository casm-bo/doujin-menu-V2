{
  "name": "doujinzip",
  "displayName": "동인집",
  "version": "2.6.0",
  "description": "만화책 관리를 위한 데스크톱 어플리케이션",
  "license": "MIT",
  "main": "build/main/main/main.js",
  "author": {
    "name": "casm",
    "url": "https://github.com/casm-bo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casm-bo/doujin-menu-V2.git"
  },
  "homepage": "https://github.com/casm-bo/doujin-menu-V2",
  "bugs": {
    "url": "https://github.com/casm-bo/doujin-menu-V2/issues"
  },
  "scripts": {
    "predev": "node scripts/rebuild-native.js",
    "dev": "node scripts/dev-server.js",
    "build": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "build:fast": "node scripts/build.js && electron-builder --win --publish=never",
    "build:port:fast": "node scripts/build.js && electron-builder --win portable --publish=never",
    "build:debug": "node scripts/build.js && DEBUG=electron-builder electron-builder --win portable --publish=never",
    "build:win": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port:win": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "prepare": "husky",
    "postinstall": "node scripts/rebuild-native.js",
    "format": "prettier --write src",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "pretest": "node scripts/rebuild-native.js",
    "test": "vitest run",
    "test:series": "node scripts/rebuild-native.js && vitest run tests/unit/main/seriesDetector.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^25.0.3",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "electron": "^43.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "semver": "^7.7.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.7",
    "vitest": "4.1.12",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.92.1",
    "@types/archiver": "^7.0.0",
    "@vueuse/core": "^14.1.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "electron-window-state": "^5.0.3",
    "fast-glob": "^3.3.3",
    "filenamify": "^7.0.1",
    "knex": "^3.1.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lucide-vue-next": "^0.562.0",
    "node-hitomi": "^9.2.0",
    "p-queue": "^9.0.1",
    "pinia": "^3.0.4",
    "pretendard": "^1.3.9",
    "reka-ui": "^2.7.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.44",
    "vue-router": "4",
    "vue-sonner": "^2.0.9",
    "yauzl": "^3.4.0"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "electron",
      "electron-winstaller",
      "sharp"
    ],
    "overrides": {
      "node-abi": "4.33.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "tar-fs@>=2.0.0 <2.1.4": ">=2.1.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.9",
      "ajv@<6.14.0": "6.15.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "lodash@<=4.17.23": ">=4.18.0",
      "defu@<=6.1.4": ">=6.1.5",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "builder-util-runtime@<9.7.0": ">=9.7.0",
      "postcss@<=8.5.22": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "nanoid@<3.3.17": ">=3.3.17",
      "postcss-selector-parser@>=7.1.0 <7.1.6": "7.1.6",
      "source-map-js@<1.2.2": "1.2.2",
      "http-cache-semantics@<=4.2.0": "4.3.0",
      "@humanfs/node@<0.16.8": ">=0.16.8",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": ">=0.8.15",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
