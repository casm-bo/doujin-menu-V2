{
  "appId": "com.casm.doujinzip",
  "productName": "동인집",
  "directories": {
    "output": "dist",
    "buildResources": "src/main/static"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "doujinzip-setup-${version}.${ext}",
    "shortcutName": "동인집"
  },
  "portable": {
    "artifactName": "doujinzip-portable-${version}.${ext}"
  },
  "linux": {
    "target": ["snap"]
  },
  "asar": true,
  "npmRebuild": false,
  "publish": {
    "provider": "github",
    "owner": "casm-bo",
    "repo": "doujin-menu-V2"
  },
  "files": ["build/main/**/*", "build/renderer/**/*", "package.json"],
  "extraResources": [
    {
      "from": "src/main/static",
      "to": "static",
      "filter": ["**/*"]
    }
  ]
}
